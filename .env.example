PORT=4000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/trippio
CLIENT_ORIGIN=http://localhost:5173
APP_ORIGIN=http://localhost:5173
ACCESS_TOKEN_SECRET=<random-secret-at-least-32-chars>
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
NODE_ENV=development

# Leave blank unless the client and API share a parent domain (e.g. both on *.trippio.com)
COOKIE_DOMAIN=

# Real email delivery for magic links (Resend). Leave RESEND_API_KEY blank in dev —
# the link is logged to the console and returned in the API response instead.
RESEND_API_KEY=
EMAIL_FROM=Trippio <hello@mail.trippio.xyz>

# Error monitoring. Leave blank to disable.
SENTRY_DSN=
